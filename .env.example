# GEMINI_API_KEY: Required if server-side Gemini features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# JWT_SECRET: Cryptographic secret for signing HTTP-only session tokens (set strong random string in production).
JWT_SECRET="replace-with-secure-64-char-random-secret"

# DATABASE_PATH: SQLite database file path (used by local Express runtime).
DATABASE_PATH="./waluh_family.db"

# BOOTSTRAP_CAPSU_EMAIL / BOOTSTRAP_CAPSU_PASSWORD: Optional initial CAPSU credentials on first boot.
BOOTSTRAP_CAPSU_EMAIL="capsu@waluhfamily.org"
BOOTSTRAP_CAPSU_PASSWORD=""

# SUPABASE / POSTGRESQL (For external Vercel + Supabase deployment; see supabase/migrations/001_waluh_family_schema.sql)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
